/*
 * FireX -- boot splash.
 *
 * NOTE ON COMMENTS: Plymouth's script language is C-like. It knows the
 * two C comment forms and nothing else; it does NOT treat '#' as a
 * comment. A '#' line is a parse error, and the script plugin reports
 * nothing at all for one -- it logs
 * "executing script file" and stops there, leaving a black screen with
 * a perfectly healthy renderer behind it. This file was written with '#'
 * comments and drew nothing for exactly that reason. Keep them as //.
 *
 * Drawn from the pieces in this directory, all generated by
 * tools/make-splash.py from include/brand.h:
 *
 *     background.png  plain backdrop, no artwork baked in
 *     logo.png        the flame, 256px square with its halo
 *     title.png       the wordmark, generated from include/brand.h
 *     tagline.png     the tagline, letter-spaced
 *     byline.png      the byline, from BRAND_AUTHOR
 *     bar.png         solid fill for the progress bar
 *     track.png       the groove behind it
 *
 * Plymouth's script language has no local scope, so everything here is
 * global by necessity and the prefixes stand in for it.
 *
 * Sprite Z order, back to front:
 *     0  backdrop     10  logo and text     20  progress     30  messages
 */

W = Window.GetWidth(0);
H = Window.GetHeight(0);

// The artwork is laid out for a 768px-high screen. Everything below is a
// multiple of `unit`, so a 4K panel and a 640x480 VESA fallback both come
// out deliberate rather than one of them tiny.
unit = H / 768;
if (unit < 0.45) unit = 0.45;

fun scaled(name) {
    img = Image(name);
    return img.Scale(img.GetWidth() * unit, img.GetHeight() * unit);
}

fun place(image, y, z) {
    s = Sprite(image);
    s.SetPosition((W - image.GetWidth()) / 2, y, z);
    return s;
}

// ── backdrop ────────────────────────────────────────────────────────────

backdrop = Sprite(Image("background.png").Scale(W, H));
backdrop.SetPosition(0, 0, 0);

// ── mark and wordmark ───────────────────────────────────────────────────

logo    = Image("logo.png").Scale(190 * unit, 190 * unit);
title   = scaled("title.png");
tagline = scaled("tagline.png");
byline  = scaled("byline.png");

block = logo.GetHeight() + 26 * unit + title.GetHeight()
      + 16 * unit + tagline.GetHeight();

logo_y    = H / 2 - block / 2 - 30 * unit;
title_y   = logo_y + logo.GetHeight() + 26 * unit;
tagline_y = title_y + title.GetHeight() + 16 * unit;

logo_sprite    = place(logo, logo_y, 10);
title_sprite   = place(title, title_y, 10);
tagline_sprite = place(tagline, tagline_y, 10);

// Pinned to the bottom, clear of the progress bar in the middle band.
byline_sprite  = place(byline, H - byline.GetHeight() - 54 * unit, 10);

// ── progress ────────────────────────────────────────────────────────────

bar_w = 220 * unit;
bar_h = 3;
bar_x = (W - bar_w) / 2;
bar_y = tagline_y + tagline.GetHeight() + 58 * unit;

track_sprite = Sprite(Image("track.png").Scale(bar_w, bar_h));
track_sprite.SetPosition(bar_x, bar_y, 20);

bar_sprite = Sprite();
bar_sprite.SetPosition(bar_x, bar_y, 21);

fun draw_progress(fraction) {
    if (fraction < 0.02) fraction = 0.02;
    if (fraction > 1)    fraction = 1;
    bar_sprite.SetImage(Image("bar.png").Scale(bar_w * fraction, bar_h));
}

draw_progress(0);

/*
 * `duration` is seconds since plymouth started; `fraction` is its own
 * estimate, built from how long the last boot took. There is no such
 * estimate on a first boot, so fall back to a slow sweep -- a bar pinned
 * at zero for forty seconds reads as a hang.
 */
fun on_boot_progress(duration, fraction) {
    if (fraction > 0) {
        draw_progress(fraction);
    } else {
        draw_progress(duration / 45);
    }
}

Plymouth.SetBootProgressFunction(on_boot_progress);

// ── messages ────────────────────────────────────────────────────────────
//
// fsck output, "a start job is running", and anything else systemd sends
// to the splash. One line under the bar, replaced each time.

message_sprite = Sprite();
message_sprite.SetPosition(0, 0, 30);

fun on_message(text) {
    image = Image.Text(text, 0.55, 0.62, 0.74, 1, "Sans 10");
    message_sprite.SetImage(image);
    message_sprite.SetPosition((W - image.GetWidth()) / 2,
                               bar_y + 26 * unit, 30);
    message_sprite.SetOpacity(1);
}

Plymouth.SetMessageFunction(on_message);
Plymouth.SetUpdateStatusFunction(on_message);

// ── password prompt ─────────────────────────────────────────────────────
//
// Nothing in the shipped image asks for one. A build with an encrypted
// root would hang on a blank screen without it, which is exactly the kind
// of thing nobody discovers until the appliance is in a rack.

prompt_sprite  = Sprite();
bullets_sprite = Sprite();
prompt_sprite.SetOpacity(0);
bullets_sprite.SetOpacity(0);

fun on_password(prompt, bullets) {
    p = Image.Text(prompt, 0.9, 0.93, 0.95, 1, "Sans 11");
    prompt_sprite.SetImage(p);
    prompt_sprite.SetPosition((W - p.GetWidth()) / 2, bar_y - 34 * unit, 30);
    prompt_sprite.SetOpacity(1);

    dots = "";
    i = 0;
    while (i < bullets) {
        dots = dots + "*";
        i = i + 1;
    }
    b = Image.Text(dots, 1, 0.29, 0.17, 1, "Sans 14");
    bullets_sprite.SetImage(b);
    bullets_sprite.SetPosition((W - b.GetWidth()) / 2, bar_y + 8 * unit, 30);
    bullets_sprite.SetOpacity(1);
}

fun clear_password() {
    prompt_sprite.SetOpacity(0);
    bullets_sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(on_password);
Plymouth.SetDisplayNormalFunction(clear_password);

// ── shutdown ────────────────────────────────────────────────────────────
//
// The same screen on the way down, minus the progress bar: an appliance
// rebooting into the other slot should not look like it crashed.

fun on_quit() {
    bar_sprite.SetOpacity(0);
    track_sprite.SetOpacity(0);
    message_sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(on_quit);
