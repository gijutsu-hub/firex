# Normalise line endings in the source tree. A CRLF that reaches a shell
# script in the rootfs overlay makes the appliance fail to boot with
# "bad interpreter", and the cause is invisible in a diff.
* text=auto eol=lf

# Shell scripts and systemd units are read by the image build and by
# systemd itself; never let a checkout rewrite them.
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.script    text eol=lf
*.plymouth  text eol=lf

# Binary assets, so git neither diffs nor converts them.
*.png       binary
*.img       binary
*.iso       binary
*.o         binary

# Keep the generated asset blob out of diffs and out of the language
# statistics: it is a C array of the web console, not hand-written C.
src/webui_assets.c linguist-generated=true -diff
